#!/usr/bin/env bash
# ai.sh - unified AI CLI launcher (Python + Node + SQLite3 bridge)

set -euo pipefail
IFS=$'\n\t'

BASE_DIR="$HOME/_/ai"
ENV_DIR="$BASE_DIR/.env.local"
TMP_DIR="$BASE_DIR/tmp"
DB_DIR="$BASE_DIR/db"

# === Activate Python environment ===
if [ -f "$ENV_DIR/bin/activate" ]; then
    source "$ENV_DIR/bin/activate"
else
    echo "[Error] Python virtualenv not found. Run installer first."
    exit 1
fi

# === Prompt ===
PROMPT="${1:-}"
if [ -z "$PROMPT" ]; then
    read -rp "Enter human prompt: " PROMPT
fi

echo "[AI] 🚀 Starting AI Hyper-Reasoning for prompt: $PROMPT"

# === Generate entropy hash ===
FRACTAL_HASH=$(echo -n "$PROMPT$(date +%s%N)" | sha256sum | cut -d' ' -f1)
echo "[AI] Generated entropy hash: $FRACTAL_HASH"

# === Python execution (Neuro reasoning / qbit → sqlite3) ===
echo "[AI] 🐍 Running Python Hyper-Reasoning..."
python3 "$BASE_DIR/ai.py" "$PROMPT" "$FRACTAL_HASH" "$DB_DIR" "$TMP_DIR"

# === Node.js execution (UI / json → dom / dex) ===
echo "[AI] 🟨 Running Node.js Crew-AI..."
node "$BASE_DIR/ai.mjs" "$PROMPT" "$FRACTAL_HASH" "$TMP_DIR"

# === Completion ===
echo "[AI] ✅ Hyper-reasoning complete. JSON stored in $TMP_DIR, DB updated in $DB_DIR"
