#!/usr/bin/env bash
# ai_cli_host_ws.sh - Full AI CLI Orchestrator + Dashboard Host

BASE="$HOME/_/ai"
TMP="$BASE/tmp"
DB="$BASE/db/qbits.sqlite3"

mkdir -p "$TMP" "$BASE/db"

# --- Initialize SQLite ---
sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS qbits (
    agent TEXT,
    prompt TEXT,
    hash TEXT,
    iteration INTEGER,
    response TEXT,
    timestamp REAL,
    temp REAL
);"

# --- Generate entropy hash ---
FRACTAL_HASH=$(openssl rand -hex 32)
echo "[NEXUS] ⚙️ Generated entropy hash: $FRACTAL_HASH"

# --- Temperature / recursion depth ---
TEMP=0.5
DEPTH=5
echo "[NEXUS] 🌡 Temperature set: $TEMP, Recursion depth: $DEPTH"

# --- Python3 Worker ---
python3 - <<PYTHON
import sqlite3, time, hashlib, json, os
DB="$DB"
TMP="$TMP"
prompt = "$1" if len("$1") > 0 else "Hello AI Crew"

conn = sqlite3.connect(DB)
c = conn.cursor()

for i in range($DEPTH):
    fractal_hash = hashlib.sha256((prompt + str(i) + "$FRACTAL_HASH").encode()).hexdigest()
    response = f"[Python3] Iter {i} hash {fractal_hash[:8]}"
    c.execute("INSERT INTO qbits (agent,prompt,hash,iteration,response,timestamp,temp) VALUES (?,?,?,?,?,?,?)",
              ("neuro", prompt, fractal_hash, i, response, time.time(), $TEMP))
    with open(os.path.join(TMP, fractal_hash+".json"), "w") as f:
        json.dump({"agent":"neuro","prompt":prompt,"hash":fractal_hash,"iteration":i,"response":response}, f)
conn.commit()
conn.close()
print(f"[PY] Qbits stored -> {fractal_hash[:8]}")
PYTHON

# --- Node.js Worker ---
node - <<NODE
const fs = require('fs'), path = require('path');
const TMP = "$TMP";
const agents = ["core","loop","code","coin","2244"];
agents.forEach(agent => {
    const filename = path.join(TMP, agent+"-stub.json");
    const stub = {agent, prompt: "$1", timestamp: Date.now(), note: "JS stub processed"};
    fs.writeFileSync(filename, JSON.stringify(stub, null, 2));
    console.log(`[JS] Crew-AI stub written to ${filename}`);
});
NODE

# --- Simple Dashboard ---
HTML="$TMP/dashboard.html"
cat > "$HTML" <<HTML_CONTENT
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>2244 AI Dashboard</title>
<style>
body { font-family: monospace; background: #272822; color:#f8f8f2; padding:20px; }
h1 { color:#f92672; } pre { background:#1b1b1b; padding:10px; border-radius:5px; overflow:auto; }
</style>
</head>
<body>
<h1>2244 AI Dashboard</h1>
<pre id="log">-- Loading qbits --</pre>
<script>
fetch('./tmp').then(()=>{}); // placeholder, later implement WebSocket streaming
</script>
</body>
</html>
HTML_CONTENT

echo "[NEXUS] ✅ Hyper-reasoning complete. JSON outputs stored in $TMP"
echo "[NEXUS] 🌐 Dashboard ready at $HTML"
